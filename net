#!/bin/zsh
# net — says in plain words why the Mac's internet is failing.
#   net check   diagnose the current connection and give a verdict
#   net scan    nearby Wi-Fi networks and channel occupancy
#   net hidden  hidden networks: vendor, distance, which router they belong to
#   net devices devices on the connected network; net bt: Bluetooth devices in reach
# Diagnosis never needs sudo.

set -u
HERE="${0:A:h}"
WIFIINFO="$HERE/net-doctor.app/Contents/MacOS/wifiinfo"
LOG=/usr/bin/log          # zsh has a builtin named `log`

bold() { print -P "%B$*%b"; }
dim()  { print -P "%F{8}$*%f"; }
row()  { printf "  %-9s %s\n" "$1" "$2"; }

need_helper() {
  if [[ ! -x "$WIFIINFO" ]]; then
    print -u2 "wifiinfo helper not built. Run: make -C $HERE"
    exit 1
  fi
}

# helper MODE -> prints the helper's output.
# macOS reveals network names only to a process launched as a real app session, so the
# helper is started with `open` and hands its result back through a temp file. If that
# fails for any reason, fall back to running the binary directly (names hidden).
helper() {
  local out; out=$(mktemp -t net-doctor) || return 1
  if open -n -g -j -W "$HERE/net-doctor.app" --args "$@" --out "$out" 2>/dev/null && [[ -s "$out" ]]; then
    cat "$out"
  else
    "$WIFIINFO" "$@"
  fi
  rm -f "$out"
}

# ---------- shared probes ----------------------------------------------------

# ping_stats HOST COUNT -> sets PLOSS (percent) and PAVG (ms, or "-")
ping_stats() {
  local out
  out=$(ping -c "$2" -i 0.2 -t 6 "$1" 2>/dev/null)
  PLOSS=$(print -r -- "$out" | sed -n 's/.* \([0-9.]*\)% packet loss.*/\1/p')
  PLOSS=${PLOSS%%.*}; PLOSS=${PLOSS:-100}
  PAVG=$(print -r -- "$out" | sed -n 's#.*= [0-9.]*/\([0-9.]*\)/.*#\1#p')
  PAVG=${PAVG%%.*}; PAVG=${PAVG:--}
}

# dns_ms SERVER NAME -> prints query time in ms, or "fail"
dns_ms() {
  local t
  t=$(dig +time=2 +tries=1 @"$1" "$2" 2>/dev/null | sed -n 's/.*Query time: \([0-9]*\) msec.*/\1/p')
  [[ -n "$t" ]] && print "$t" || print fail
}
fmt_ms() { [[ "$1" == fail ]] && print fail || print "$1 ms"; }

# https_probe -> sets HCODE and HTIME
https_probe() {
  local r
  r=$(curl -s -o /dev/null -m 8 -w '%{http_code} %{time_total}' https://www.google.com/generate_204 2>/dev/null)
  HCODE=${r%% *}; HTIME=${r##* }
  [[ "$HCODE" == "000" || -z "$HCODE" ]] && HCODE=fail
  HTIME=$(awk -v t="$HTIME" 'BEGIN{printf "%d", t*1000}')
}

# vendor_of MAC -> the maker behind a MAC address, from Wireshark's vendor list (cached once).
# A locally-set address (2nd hex digit 2/6/a/e) is either a phone hiding its identity or a
# router's extra BSSID derived from its real one; the latter shows as "likely <vendor>".
MANUF="${XDG_CACHE_HOME:-$HOME/.cache}/net-doctor/manuf"
vendor_of() {
  local -a o; o=(${(s.:.)${(U)1}}); (( ${#o} == 6 )) || return 0
  local i; for i in {1..6}; do [[ ${#o[i]} == 1 ]] && o[i]="0${o[i]}"; done
  if [[ ! -s "$MANUF" ]]; then
    mkdir -p "${MANUF:h}"; print -u2 "  downloading the MAC vendor list (once, 3 MB)…"
    curl -sL -m 60 -o "$MANUF" https://www.wireshark.org/download/automated/data/manuf || { rm -f "$MANUF"; return 0; }
  fi
  local prefix="" local=""
  if [[ "${o[1][2]}" == [26AE] ]]; then
    local -A clear; clear=(2 0 6 4 A 8 E C)
    o[1]="${o[1][1]}${clear[${o[1][2]}]}"; local="likely "
  fi
  local k line
  for k in "${o[1]}:${o[2]}:${o[3]}:${o[4]}:${o[5][1]}0/36" "${o[1]}:${o[2]}:${o[3]}:${o[4][1]}0/28" "${o[1]}:${o[2]}:${o[3]}"; do
    line=$(grep -m1 "^${k}[[:space:]]" "$MANUF") && { print -r -- "${local}${line##*$'\t'}"; return 0; }
  done
  [[ -n "$local" ]] && print "private address"
}

# ---------- check ------------------------------------------------------------

cmd_check() {
  need_helper
  bold "net check  $(date '+%H:%M:%S')"
  echo

  # Which interface carries the default route?
  local IF GW IP DNS1 SVC
  IF=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')
  if [[ -z "$IF" ]]; then
    row "Link" "no default route — not connected to any network"
    echo; bold "Verdict:"; echo "  The Mac is not on a network at all. Turn Wi-Fi on or plug in."
    return
  fi
  IP=$(ipconfig getifaddr "$IF" 2>/dev/null)
  GW=$(ipconfig getoption "$IF" router 2>/dev/null)
  DNS1=$(ipconfig getoption "$IF" domain_name_server 2>/dev/null)
  [[ -z "$DNS1" ]] && DNS1=$(scutil --dns 2>/dev/null | awk '/nameserver\[0\]/{print $3; exit}')
  SVC=$(networksetup -listallhardwareports 2>/dev/null | awk -v d="$IF" '/Hardware Port/{p=$0; sub(/Hardware Port: /,"",p)} /Device:/ && $2==d {print p}')
  row "Link" "${SVC:-$IF} ($IF) → $IP, router ${GW:--}, DNS ${DNS1:--}"

  # Radio readings, only when the default route is the Wi-Fi interface.
  local WIFI_IF ON_WIFI=0 RSSI=0 NOISE=0 SNR=0 CH=0 W=0 BAND="" TX=0 SNR_WORD=""
  WIFI_IF=$(networksetup -listallhardwareports 2>/dev/null | awk '/Wi-Fi/{getline; print $2}')
  local STALLS=0 TIMEOUTS=0 CCAMAX="-" LOGRSSI="" LOGNOISE=""
  if [[ "$IF" == "$WIFI_IF" ]]; then
    ON_WIFI=1
    local kv; typeset -A W_INFO
    while IFS='=' read -r k v; do W_INFO[$k]="$v"; done < <(helper info)
    RSSI=${W_INFO[rssi]:-0}; NOISE=${W_INFO[noise]:-0}; CH=${W_INFO[channel]:-0}
    W=${W_INFO[width]:-0}; BAND=${W_INFO[band]:-}; TX=${W_INFO[txrate]:-0}

    # Driver log: stall counters, channel-busy %, and the RSSI/noise the driver saw
    # (newer macOS hides the connected link's RSSI from CoreWLAN; the log still has it).
    print -n -u2 "  reading Wi-Fi driver log (10 min)…"
    local DRV
    DRV=$($LOG show --last 10m --style compact --predicate 'process == "kernel" AND (eventMessage CONTAINS "DPS Symptoms" OR eventMessage CONTAINS "Datapath timeout" OR eventMessage CONTAINS "APPLE80211_M_RSSI_CHANGED")' 2>/dev/null)
    print -u2 -n "\r\e[2K"
    STALLS=$(print -r -- "$DRV" | grep -c 'DPS Symptoms')
    TIMEOUTS=$(print -r -- "$DRV" | grep -c 'Datapath timeout')
    CCAMAX=$(print -r -- "$DRV" | grep -o 'CCA:[0-9]*' | cut -d: -f2 | sort -n | tail -1)
    CCAMAX=${CCAMAX:--}
    LOGRSSI=$(print -r -- "$DRV" | grep -o 'RSSI -[0-9]* noise -[0-9]*' | tail -1 | awk '{print $2}')
    LOGNOISE=$(print -r -- "$DRV" | grep -o 'RSSI -[0-9]* noise -[0-9]*' | tail -1 | awk '{print $4}')
    [[ "$RSSI" == "0" && -n "$LOGRSSI" ]] && RSSI=$LOGRSSI
    [[ "$NOISE" == "0" && -n "$LOGNOISE" ]] && NOISE=$LOGNOISE

    if [[ "$RSSI" != "0" && "$NOISE" != "0" ]]; then
      SNR=$(( RSSI - NOISE ))
      if   (( SNR >= 25 )); then SNR_WORD=good
      elif (( SNR >= 15 )); then SNR_WORD=fair
      else SNR_WORD=poor; fi
      row "Radio" "ch $CH ($BAND GHz, ${W} MHz) · signal ${RSSI} dBm · noise ${NOISE} dBm · SNR ${SNR} dB ($SNR_WORD) · ${TX} Mb/s"
    else
      row "Radio" "ch $CH ($BAND GHz, ${W} MHz) · ${TX} Mb/s · signal not readable right now"
    fi
    if (( STALLS + TIMEOUTS == 0 )); then
      row "Stalls" "last 10 min: none logged by the driver"
    else
      local busy=""; [[ "$CCAMAX" != "-" ]] && busy=", channel busy up to ${CCAMAX}%"
      row "Stalls" "last 10 min: $STALLS driver stalls, $TIMEOUTS datapath timeouts$busy"
    fi
  fi

  # Layered probes: router → internet → DNS via router → DNS direct → HTTPS
  local RLOSS=- RAVG=- ILOSS IAVG DNS_R DNS_D
  if [[ -n "$GW" ]]; then
    ping_stats "$GW" 10; RLOSS=$PLOSS; RAVG=$PAVG
    row "Router" "$GW: ${RLOSS}% loss, avg ${RAVG} ms"
  fi
  ping_stats 1.1.1.1 10; ILOSS=$PLOSS; IAVG=$PAVG
  row "Internet" "1.1.1.1: ${ILOSS}% loss, avg ${IAVG} ms"
  DNS_R=$(dns_ms "${DNS1:-$GW}" apple.com)
  DNS_D=$(dns_ms 1.1.1.1 apple.com)
  row "DNS" "via ${DNS1:-router}: $(fmt_ms $DNS_R) · direct 1.1.1.1: $(fmt_ms $DNS_D)"
  https_probe
  if [[ "$HCODE" == fail ]]; then row "HTTPS" "google.com/generate_204: failed"
  else row "HTTPS" "google.com/generate_204: HTTP $HCODE in ${HTIME} ms"; fi

  # Things that intercept traffic
  local PROXY="none" VPN FILTERS
  if scutil --proxy | grep -qE '(HTTPEnable|HTTPSEnable|SOCKSEnable|ProxyAutoConfigEnable) : 1'; then PROXY="system proxy ON"; fi
  if env | grep -qiE '^(https?|all)_proxy='; then PROXY="$PROXY, proxy env vars set"; fi
  VPN=$(scutil --nc list 2>/dev/null | grep -c '(Connected)')
  FILTERS=$(systemextensionsctl list 2>/dev/null | grep -c 'activated enabled')
  row "Config" "proxy: $PROXY · VPN connected: $VPN · network extensions enabled: $FILTERS"

  # ---------- verdict ----------
  echo; bold "Verdict:"
  local v
  if (( ON_WIFI )) && [[ "$RLOSS" != "-" ]] && { (( RLOSS >= 30 )) || (( STALLS > 0 )) || (( TIMEOUTS > 0 )); }; then
    v="The Wi-Fi link between this Mac and the router is the problem."
    (( RLOSS >= 30 )) && v="$v ${RLOSS}% of pings to the router are lost."
    (( STALLS + TIMEOUTS > 0 )) && v="$v The driver logged $STALLS stalls and $TIMEOUTS timeouts in 10 minutes."
    [[ "$CCAMAX" != "-" ]] && (( CCAMAX >= 70 )) && v="$v The channel was up to ${CCAMAX}% busy: a crowded channel, not a bad router."
    [[ -n "$SNR_WORD" && "$SNR_WORD" == poor ]] && v="$v Signal margin is only ${SNR} dB, which makes it fragile."
    v="$v Try: move closer, change the router's 5 GHz channel (run \`net scan\` to pick one), or use the 2.4 GHz network."
  elif [[ "$RLOSS" != "-" ]] && (( RLOSS < 30 )) && (( ILOSS >= 30 )); then
    v="The router is reachable but the internet behind it is not. This is the router's uplink or the ISP, not this Mac. Other devices on the network should be failing too; power-cycle the router if they are."
  elif (( ILOSS < 30 )) && [[ "$DNS_R" == fail && "$DNS_D" != fail ]]; then
    v="Internet works but the router's DNS (${DNS1:-router}) is not answering. Set the Mac's DNS to 1.1.1.1 or 8.8.8.8 as a workaround, or restart the router."
  elif (( ILOSS < 30 )) && [[ "$DNS_R" == fail && "$DNS_D" == fail ]]; then
    v="Internet works but no DNS server answers, even directly. Something between here and the internet is blocking DNS: a VPN, a filter, or a captive portal. Open a browser and check for a login page."
  elif (( ILOSS < 30 )) && [[ "$HCODE" == fail ]]; then
    v="Ping and DNS work but HTTPS fails. That points at something intercepting traffic: a proxy, a VPN, or a network extension (see Config). Disconnect the VPN or disable the proxy and re-run."
  else
    v="Everything is working right now."
    if (( ON_WIFI )) && [[ -n "$SNR_WORD" ]]; then
      case $SNR_WORD in
        poor) v="$v But the Wi-Fi margin is thin (SNR ${SNR} dB); expect stalls when the channel gets busy. \`net scan\` shows quieter channels." ;;
        fair) v="$v Wi-Fi margin is fair (SNR ${SNR} dB)." ;;
        good) v="$v Wi-Fi link is healthy (SNR ${SNR} dB)." ;;
      esac
    fi
    (( VPN > 0 )) && v="$v A VPN is connected; if an app still fails, it is the first thing to suspect."
  fi
  print -- "  $v" | fold -s -w 96 | sed '2,$s/^/  /'
}

# ---------- scan -------------------------------------------------------------

cmd_scan() {
  need_helper
  bold "net scan  $(date '+%H:%M:%S')"
  print -u2 "  scanning…\c"
  local SCAN; SCAN=$(helper scan)
  print -u2 -n "\r\e[2K"

  typeset -A CUR; while IFS='=' read -r k v; do CUR[$k]="$v"; done < <(helper info)
  local curch=${CUR[channel]:-0}
  echo
  printf "  %-4s %-6s %-5s %-9s %s\n" ch width band signal name
  # If no network at all has a name, macOS is withholding them; if only some are blank,
  # those networks simply do not broadcast a name.
  local named; named=$(print -r -- "$SCAN" | grep -cv $'\t$')
  local blank="(hidden network)"; (( named == 0 )) && blank="(name withheld)"
  print -r -- "$SCAN" | while IFS=$'\t' read -r ch w band rssi bssid ssid; do
    local mark=" "; [[ "$ch" == "$curch" && "$curch" != 0 ]] && mark="*"
    [[ -z "$ssid" ]] && ssid="$blank"
    printf " %s%-4s %-6s %-5s %-9s %s\n" "$mark" "$ch" "${w}MHz" "$band" "${rssi} dBm" "$ssid"
  done
  (( named == 0 )) && dim "  Names withheld by macOS: run \`net auth\` once, or turn on net-doctor in System Settings › Privacy & Security › Location Services."
  [[ "$curch" != 0 ]] && dim "  * = the channel this Mac is on (ch $curch)"

  # 5 GHz occupancy by 80 MHz block
  echo; bold "  5 GHz channel blocks"
  local -a blocks; blocks=("36-48" "52-64" "100-112" "116-128" "132-144" "149-161")
  local best="" bestn=999 curblock="" curn=-1
  for b in $blocks; do
    local lo=${b%-*} hi=${b#*-} n=0 strongest=-200
    while IFS=$'\t' read -r ch w band rssi rest; do
      [[ "$band" != "5" ]] && continue
      if (( ch >= lo && ch <= hi )); then n=$((n+1)); (( rssi > strongest )) && strongest=$rssi; fi
    done <<< "$SCAN"
    local here=""
    # our own network shows up in the scan too; count only the others in our block
    if (( curch >= lo && curch <= hi )); then here="  ← you are here"; curblock=$b; (( n > 0 )) && n=$((n-1)); curn=$n; fi
    local dfs=""; (( lo >= 52 && lo <= 144 )) && dfs=" DFS"
    if (( n == 0 )); then printf "  %-9s%-4s no other networks%s\n" "$b" "$dfs" "$here"
    else printf "  %-9s%-4s %d other network(s), strongest %d dBm%s\n" "$b" "$dfs" "$n" "$strongest" "$here"; fi
    # prefer empty non-DFS, then empty DFS, then fewest networks; ties keep the current block
    local score=$(( n * 10 + ( ${#dfs} > 0 ? 1 : 0 ) ))
    if (( score < bestn )) || { (( score == bestn )) && [[ "$b" == "$curblock" ]]; }; then bestn=$score; best=$b; fi
  done
  echo
  if [[ "$best" == "$curblock" ]] || (( curn == 0 )); then
    print -- "  You are already on a quiet block ($curblock): no other networks share it."
  elif [[ -n "$best" ]]; then
    print -- "  Quietest block from here: $best. Set the router's 5 GHz channel to ${best%-*} if it offers it;"
    print -- "  routers often skip 36–48 or 116–128, so take the next quietest block above."
    dim "  DFS blocks pause for about a minute after a change while the router listens for radar."
  fi

  # 2.4 GHz
  local n1=0 n6=0 n11=0 nother=0
  while IFS=$'\t' read -r ch w band rest; do
    [[ "$band" != "2.4" ]] && continue
    case $ch in 1) n1=$((n1+1));; 6) n6=$((n6+1));; 11) n11=$((n11+1));; *) nother=$((nother+1));; esac
  done <<< "$SCAN"
  echo; bold "  2.4 GHz"; print -- "  ch 1: $n1 · ch 6: $n6 · ch 11: $n11 · other: $nother"
}

# ---------- hidden -----------------------------------------------------------

# where_from RSSI -> rough distance for a Wi-Fi access point (they transmit ~100× louder than BLE)
where_from() {
  if   (( $1 >= -50 )); then print "right here: this room or through one wall"
  elif (( $1 >= -65 )); then print "close: this apartment or the one next door"
  elif (( $1 >= -78 )); then print "a few walls away"
  else print "far: another floor or building"; fi
}

cmd_hidden() {
  need_helper
  local follow=""; [[ "${1:-}" == "--follow" ]] && follow=1
  typeset -A CUR; while IFS='=' read -r k v; do CUR[$k]="$v"; done < <(helper info)
  typeset -A prev
  local ALL ch w band rssi bssid sec gen cc ssid details vendor same delta n strongest strongest_v own scale
  while :; do
    bold "net hidden  $(date '+%H:%M:%S')"
    print -u2 -n "  scanning…"
    ALL=$(helper beacons)
    print -u2 -n "\r\e[2K"
    n=0 strongest=-200 strongest_v="" own=0
    # our own network, for scale: by name/address, else the loudest named network on our channel
    own=$(print -r -- "$ALL" | awk -F$'\x1f' -v s="${CUR[ssid]:-}" -v b="${CUR[bssid]:-}" -v ch="${CUR[channel]:-0}" -v best=-200 -v onch=-200 '
      $9 != "" && (($9 == s && s != "") || ($5 == b && b != "")) && $4 > best { best = $4 }
      $9 != "" && $1 == ch && ch != 0 && $4 > onch { onch = $4 }
      END { print (best > -200 ? best : (onch > -200 ? onch : 0)) }')
    while IFS=$'\x1f' read -r ch w band rssi bssid sec gen cc ssid details; do
      [[ -n "$ssid" ]] && continue
      n=$((n+1))
      vendor=$(vendor_of "$bssid")
      if (( rssi > strongest )); then strongest=$rssi; strongest_v=${vendor:-unknown vendor}; fi
      if [[ -n "$follow" ]]; then
        delta=""; [[ -n "${prev[$bssid]:-}" ]] && delta=$(printf "%+d" $(( rssi - prev[$bssid] )))
        printf "  %-9s %-5s %-19s %s\n" "${rssi} dBm" "$delta" "$bssid" "${vendor:-}"
        prev[$bssid]=$rssi
        continue
      fi
      echo
      printf "  %-19s %-9s ch %-4s %-8s %-10s %s\n" "$bssid" "${rssi} dBm" "$ch" "${band} GHz" "$sec" "$gen"
      row "  where" "$(where_from "$rssi")"
      [[ -n "$vendor" ]] && row "  vendor" "$vendor"
      # the same box: a router's extra names share the channel and the last two octets of the
      # address (aa:bb:cc:dd:EE:FF), or all but the last octet
      same=$(print -r -- "$ALL" | awk -F$'\x1f' -v ch="$ch" -v b="$bssid" '
        $9 != "" && (($1 == ch && substr($5, 13) == substr(b, 13)) || substr($5, 1, 14) == substr(b, 1, 14)) { print $9; exit }')
      [[ -n "$same" ]] && row "  router" "the same box that broadcasts $same (its extra, unnamed network)"
      [[ -n "$details" ]] && row "  beacon" "$details"
    done <<< "$ALL"
    if [[ -n "$follow" ]]; then
      (( n == 0 )) && echo "  no hidden networks in range"
      echo; sleep 2; continue
    fi
    echo
    if (( n == 0 )); then
      echo "  No hidden networks in range right now."
    else
      scale=""; (( own != 0 )) && scale=" (your own router reads ${own} dBm from here)"
      if (( strongest >= -50 )) || (( own != 0 && strongest >= own + 5 )); then
        print -- "  ⚠ The strongest hidden network, ${strongest} dBm from ${strongest_v}, is loud enough to be inside this"
        print -- "  apartment or in an adjoining wall${scale}. Run \`net hidden --follow\` and walk around: the number"
        print -- "  climbs as you get closer. Cameras and other small IoT devices usually come from Espressif, Tuya,"
        print -- "  Realtek, Hikvision, Dahua or an unlisted Shenzhen maker."
      else
        print -- "  None of the ${n} hidden network(s) is close: the strongest is ${strongest} dBm${scale}."
        print -- "  A camera in this apartment would be the loudest thing in the list. These are neighbours' routers'"
        print -- "  extra names, mesh backhaul links or set-up hotspots."
      fi
    fi
    dim "  Hidden means only the name is withheld; the address, maker and radio details are still broadcast."
    dim "  A camera that joins a Wi-Fi network instead of making its own shows in \`net devices\`, not here;"
    dim "  one that records to a card or a wire emits nothing on Wi-Fi: try \`net bt\`."
    break
  done
}

# ---------- devices ----------------------------------------------------------

# probe_device IP MAC -> what one LAN device reveals without credentials
probe_device() {
  local ip=$1 mac=${2:-}
  bold "net devices $ip  $(date '+%H:%M:%S')"
  local name; name=$(dig @224.0.0.251 -p 5353 -x "$ip" +short +time=1 +tries=2 2>/dev/null | head -1); name=${name%.}
  [[ -z "$mac" ]] && { ping -c 1 -W 500 -t 1 -q "$ip" >/dev/null 2>&1; mac=$(arp -an | awk -v ip="($ip)" '$2==ip{print $4}'); }
  row "address" "$ip"
  [[ -n "$mac" ]] && {
    # second hex digit with bit 1 set = locally administered = randomized/private address
    local b2=${mac%%:*}; b2=${(L)b2}; [[ ${#b2} == 1 ]] && b2="0$b2"
    local priv=""; [[ "${b2:1:1}" == [26ae] ]] && priv=" (private/randomized address)"
    row "mac" "$mac$priv"
    local vendor; vendor=$(vendor_of "$mac"); [[ -n "$vendor" && "$vendor" != "private address" ]] && row "vendor" "$vendor"
  }
  row "mDNS name" "${name:--}"
  # Apple devices publish their model over mDNS
  if [[ -n "$name" ]]; then
    local model; model=$(dig @224.0.0.251 -p 5353 "${name%.local}._device-info._tcp.local" TXT +short +time=1 +tries=1 2>/dev/null | tr -d '"' | grep -o 'model=[^ ]*\|osxvers=[0-9]*' | tr '\n' ' ')
    [[ -n "$model" ]] && row "device-info" "$model"
  fi
  # quick look at common TCP ports (1 s each, all at once)
  local -A pnames; pnames=(22 ssh 53 dns 80 http 443 https 445 smb 548 afp 554 rtsp-camera 1883 mqtt 3389 rdp 5000 upnp/synology 5353 mdns 7000 airplay 8008 chromecast 8009 chromecast 8080 http-alt 8443 https-alt 9100 printer 32400 plex 49152 upnp 62078 iphone-sync)
  local open=() port tmp; tmp=$(mktemp -t net-doctor)
  for port in ${(k)pnames}; do ( nc -z -G 1 -w 1 "$ip" "$port" >/dev/null 2>&1 && print "$port" >> "$tmp" ) & done
  wait
  for port in $(sort -n "$tmp" 2>/dev/null); do open+=("$port/${pnames[$port]}"); done
  rm -f "$tmp"
  row "open ports" "${open:--none of the common ones}"
  # web server banner, if any
  local scheme hdr title
  for port in 80 443 8080; do
    (( ${open[(I)$port/*]} )) || continue
    scheme=http; [[ $port == 443 ]] && scheme=https
    hdr=$(curl -sk -m 3 -o /dev/null -w '%{http_code} %{redirect_url}' -D - "$scheme://$ip:$port/" 2>/dev/null | awk 'tolower($1)=="server:"{sub(/^[^ ]+ /,""); s=$0} END{print s}' | tr -d '\r')
    title=$(curl -skL -m 3 "$scheme://$ip:$port/" 2>/dev/null | grep -o -i '<title>[^<]*' | head -1 | sed 's/<title>//I')
    [[ -n "$hdr$title" ]] && row "$scheme:$port" "${hdr:+server: $hdr }${title:+title: $title}"
  done
  # a guess at what it is, from the cheapest signals
  local guess=""
  if   (( ${open[(I)62078/*]} )); then guess="iPhone or iPad (port 62078 is Apple's device-sync service)"
  elif (( ${open[(I)7000/*]} )) && (( ${open[(I)5000/*]} )); then guess="Apple TV, HomePod or a Mac with AirPlay Receiver on"
  elif (( ${open[(I)8009/*]} )); then guess="Chromecast, Google TV or Android TV"
  elif (( ${open[(I)9100/*]} )); then guess="network printer"
  elif (( ${open[(I)554/*]} )); then guess="IP camera or NVR"
  elif (( ${open[(I)32400/*]} )); then guess="Plex server"
  elif (( ${open[(I)1883/*]} )); then guess="MQTT broker / smart-home hub"
  elif [[ "$ip" == "$(ipconfig getoption "$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')" router 2>/dev/null)" ]]; then guess="the router"
  elif (( ${open[(I)445/*]} )) || (( ${open[(I)3389/*]} )); then guess="Windows PC or NAS"
  elif (( ${open[(I)548/*]} )) || (( ${open[(I)22/*]} )); then guess="Mac, Linux box or NAS"
  elif [[ "$name" == *-MacBook* || "$name" == *-iMac* || "$name" == *-Mac-* ]]; then guess="Mac (from its name)"
  fi
  [[ -n "$guess" ]] && row "looks like" "$guess"
  dim "  Everything above is what the device offers to anyone on the network; nothing was logged into."
}

cmd_devices() {
  if [[ -n "${1:-}" ]]; then probe_device "$1"; return; fi
  local IF IP GW MASK
  IF=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')
  [[ -z "$IF" ]] && { echo "Not connected to any network."; return 1; }
  IP=$(ipconfig getifaddr "$IF"); GW=$(ipconfig getoption "$IF" router); MASK=$(ipconfig getoption "$IF" subnet_mask)
  bold "net devices  $(date '+%H:%M:%S')"
  echo "  network ${IP%.*}.0/24 via $IF (router ${GW:--})"
  [[ "$MASK" != "255.255.255.0" && -n "$MASK" ]] && dim "  subnet mask is $MASK; only the /24 around this Mac is swept"
  print -u2 -n "  sweeping 254 addresses…"
  # one ping per address, all at once; replies land in the ARP table whether or not
  # the device answers ping (the ARP exchange alone is enough)
  local i; for i in {1..254}; do ping -c 1 -W 500 -t 1 -q "${IP%.*}.$i" >/dev/null 2>&1 & done; wait
  print -u2 -n "\r\e[2K"
  echo
  printf "  %-16s %-18s %-20s %s\n" address mac vendor name
  local n=0 line ip mac name vendor
  # arp -an is instant; names come from a one-shot mDNS reverse query per device, which
  # Apple and most modern devices answer with their own name
  arp -an -i "$IF" 2>/dev/null | grep -v incomplete | sort -t. -k4 -n | while read -r line; do
    ip=${${line#*\(}%%\)*}; mac=$(print -r -- "$line" | awk '{print $4}')
    [[ "$ip" == *.255 || "$mac" == ff:ff:ff:ff:ff:ff || "$ip" == "$IP" ]] && continue
    [[ "$ip" != "${IP%.*}".* ]] && continue
    name=$(dig @224.0.0.251 -p 5353 -x "$ip" +short +time=1 +tries=2 2>/dev/null | head -1)
    name=${name%.local.}
    [[ "$ip" == "$GW" ]] && name="${name:+$name }(router)"
    n=$((n+1))
    vendor=$(vendor_of "$mac")
    printf "  %-16s %-18s %-20.20s %s\n" "$ip" "$mac" "${vendor:--}" "$name"
  done
  printf "  %-16s %-18s %-20.20s %s\n" "$IP" "$(ifconfig "$IF" | awk '/ether/{print $2}')" "Apple" "$(scutil --get LocalHostName 2>/dev/null) (this Mac)"
  echo
  local total; total=$(arp -an -i "$IF" 2>/dev/null | grep -v incomplete | grep -v "($IP)" | grep -c "(${IP%.*}\.[0-9]*)")
  echo "  $total other device(s) on the network right now."
  dim "  Devices that do not answer mDNS show no name. The router's admin page also lists clients by band;"
  dim "  this view catches wired devices too, and anything asleep that still answers ARP."
  dim "  Apple devices rotate their MAC addresses per network, so the same phone can look different on each Wi-Fi."
}

# ---------- bt --------------------------------------------------------------

cmd_bt() {
  need_helper
  if [[ -n "${1:-}" ]]; then
    if [[ "${2:-}" == "--probe" ]]; then
      # connect and read the public services; vendor services are listed, not read
      bold "net bt $1 --probe  $(date '+%H:%M:%S')"
      dim "  Connecting to a device you do not own: it is a read of public information and changes nothing,"
      dim "  but the owner's app may log a connection. Use on devices you are responsible for."
      print -u2 -n "  listening and connecting (up to 25 s)…"
      local R; R=$(helper btprobe "$1")
      print -u2 -n "\r\e[2K"
      print -r -- "$R" | sed 's/^/  /'
      return
    fi
    # net bt <name or id fragment>: every field that device advertises
    bold "net bt $1  $(date '+%H:%M:%S')"
    print -u2 -n "  listening (6 s)…"
    local R; R=$(helper bt "$1")
    print -u2 -n "\r\e[2K"
    [[ -z "$R" ]] && { echo "  No device matching '$1' heard. Names are case-insensitive; an id is the 8-character code from \`net bt\`."; return 1; }
    print -r -- "$R" | sed 's/^/  /'
    dim "  Add --probe to connect and read its public device information."
    return
  fi
  bold "net bt  $(date '+%H:%M:%S')"
  print -u2 -n "  listening for Bluetooth advertisements (6 s)…"
  local BT; BT=$(helper bt)
  print -u2 -n "\r\e[2K"
  case "$BT" in
    error=bluetooth-unauthorized) echo "  Bluetooth access denied. System Settings › Privacy & Security › Bluetooth, turn on net-doctor."; return 1 ;;
    error=bluetooth-off)          echo "  Bluetooth is turned off."; return 1 ;;
    error=*)                      echo "  ${BT#error=}"; return 1 ;;
  esac
  echo
  printf "  %-8s %-10s %-28s %s\n" signal vendor kind name
  local rssi vendor kind name id hits n=0 near=0
  while IFS=$'\x1f' read -r rssi vendor kind name id hits; do
    [[ -z "$rssi" ]] && continue
    n=$((n+1)); (( rssi >= -60 )) && near=$((near+1))
    printf "  %-8s %-10s %-28s %s\n" "${rssi} dBm" "${vendor:--}" "${kind:--}" "$name"
  done <<< "$BT"
  echo
  echo "  $n device(s) heard, $near of them within a few metres (stronger than -60 dBm)."
  dim "  Kind is read from the advertisement: Apple devices say what they are, most others only who made them."
  dim "  Addresses rotate every few minutes, so the same device can appear twice; names show only if the device sends one."
}

# ---------- dispatch ---------------------------------------------------------

cmd_auth() {
  need_helper
  echo "Asking macOS for Location Services access so network names show in \`net scan\`."
  echo "A dialog should appear for net-doctor. Click Allow."
  local r; r=$(helper auth)
  case "${r#status=}" in
    granted) echo "Granted. Network names will now appear." ;;
    denied)  echo "Denied. To change it: System Settings › Privacy & Security › Location Services, turn on your terminal app." ;;
    timeout) echo "No answer within two minutes. If no dialog appeared, your terminal app may already be listed in System Settings › Privacy & Security › Location Services; turn it on there." ;;
    *)       echo "Result: $r" ;;
  esac
}

case "${1:-}" in
  check) cmd_check ;;
  scan)  cmd_scan ;;
  hidden) cmd_hidden "${2:-}" ;;
  devices) cmd_devices "${2:-}" ;;
  bt)    cmd_bt "${2:-}" "${3:-}" ;;
  auth)  cmd_auth ;;
  *)
    cat <<EOF
net — says in plain words why the Mac's internet is failing

  net check   diagnose the current connection and give a verdict
  net scan    nearby Wi-Fi networks and which channel block is quietest
  net hidden  what the hidden networks around you are and whether one is in this apartment; --follow to walk and watch
  net devices every device on the network you are connected to; `net devices <ip>` probes one
  net bt      every Bluetooth device within reach; `net bt <name>` shows everything one device advertises
  net auth    one-time: allow Location Services so scan shows network names

Diagnosis never needs sudo.
EOF
    ;;
esac
